    <string name="settings_title">Réglages</string>
    <string name="settings_how_header">Comment ça marche</string>
    <string name="settings_how_body">ScrubPony réécrit chaque photo sur votre appareil en retirant les blocs de métadonnées qui portent le lieu, l\'heure de prise, le modèle d\'appareil et les miniatures. Les données de l\'image sont copiées octet par octet, la photo obtenue est donc identique à l\'œil.</string>
    <string name="settings_limits_body">Rien n\'est envoyé et aucune connexion n\'est nécessaire. Vos originaux ne sont jamais modifiés : chaque nettoyage écrit une nouvelle copie propre.</string>

    <string name="settings_options_header">Options de nettoyage</string>
    <string name="option_keep_orientation">Garder l\'orientation</string>
    <string name="option_keep_orientation_sub">Conserve la rotation verticale lorsque seules les métadonnées retirées l\'enregistraient.</string>
    <string name="option_strict">Strict</string>
    <string name="option_strict_sub">Retire aussi le profil colorimétrique. Les couleurs peuvent changer dans certaines applis, mais il reste encore moins de traces.</string>

