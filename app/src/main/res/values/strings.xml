    <!-- Settings: sections -->
    <string name="settings_title">Settings</string>
    <string name="settings_how_header">How it works</string>
    <string name="settings_how_body">ScrubPony rewrites each photo on your device, dropping the metadata blocks that carry location, capture time, camera model and thumbnails. The image data is copied through byte for byte, so the picture you get back is identical to look at.</string>
    <string name="settings_limits_body">Nothing is uploaded and nothing needs a network. Your originals are never changed: every scrub writes a fresh clean copy.</string>

    <!-- Settings: scrub options -->
    <string name="settings_options_header">Scrub options</string>
    <string name="option_keep_orientation">Keep orientation</string>
    <string name="option_keep_orientation_sub">Preserve the upright rotation when the dropped metadata was the only thing recording it.</string>
    <string name="option_strict">Strict</string>
    <string name="option_strict_sub">Also drop the colour profile. Colours may shift in some apps, but even less is left behind.</string>

