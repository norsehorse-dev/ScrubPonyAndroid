    <string name="onboard_start">Get started</string>
    <string name="onboard_welcome_title">Keep the photo. Lose the metadata.</string>
    <string name="onboard_welcome_body">ScrubPony strips the hidden data out of your photos while leaving the picture itself untouched.</string>
    <string name="onboard_local_title">Everything stays on your device</string>
    <string name="onboard_local_body">Scrubbing happens right here, offline. Nothing is uploaded, and your original files are never overwritten.</string>
    <string name="onboard_formats_title">JPEG, PNG, WebP and HEIC</string>
    <string name="onboard_formats_body">Pick one photo or a whole batch. ScrubPony handles the common formats, including the HEICs your phone camera makes.</string>
    <string name="onboard_share_title">Scrub from anywhere</string>
    <string name="onboard_share_body">Share a photo into ScrubPony from any app, or open it here and pick from your gallery or Files. Then save or share the clean copy.</string>

