    <string name="settings_title">Ajustes</string>
    <string name="settings_how_header">Como funciona</string>
    <string name="settings_how_body">O ScrubPony reescreve cada foto no seu aparelho, removendo os blocos de metadados que carregam localização, hora da captura, modelo da câmera e miniaturas. Os dados da imagem são copiados byte a byte, então a foto que você recebe fica idêntica.</string>
    <string name="settings_limits_body">Nada é enviado e nenhuma conexão é necessária. Seus originais nunca são alterados: cada limpeza grava uma nova cópia limpa.</string>

    <string name="settings_options_header">Opções de limpeza</string>
    <string name="option_keep_orientation">Manter orientação</string>
    <string name="option_keep_orientation_sub">Mantém a rotação correta quando só os metadados removidos a registravam.</string>
    <string name="option_strict">Rígido</string>
    <string name="option_strict_sub">Também remove o perfil de cor. As cores podem mudar em alguns apps, mas sobra ainda menos rastro.</string>

